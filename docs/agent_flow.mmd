%% L10n Quality Agent: 현재 UI의 Agent-first 실행 경로
flowchart LR
    A[원문 입력<br/>목표 국가·언어] --> B[컨텍스트 구성<br/>TM · 용어집 · DNE · 보호 용어]
    B --> C[초기 번역<br/>ChatPromptTemplate → Qwen]
    C --> D{Python 안전 검증}
    D -->|숫자·단위·보호 용어 통과| E[MQM 평가<br/>chains.evaluate()]
    D -->|결정적 경고| F[Agent 조사<br/>MQM 재평가]
    E --> G{오류가 있는가?}
    G -->|없음| H[사람 최종 승인]
    G -->|있음| I[Planner<br/>수정 영역 또는 human_review 선택]
    F --> I
    I -->|accuracy · terminology · spelling<br/>grammar · style · fluency| J[해당 영역 수정<br/>chains.revise()]
    J --> K[후보 검증 + MQM 재평가]
    K -->|통과| H
    K -->|실패·상한 도달| L[사람 검토]
    I -->|human_review| L
    H --> M[결과 CSV + RunRecord JSON 저장]
    L --> M

    classDef input fill:#14243A,stroke:#42D6C4,color:#F2F6FB;
    classDef check fill:#14243A,stroke:#FFC36A,color:#F2F6FB;
    classDef human fill:#14243A,stroke:#FA807D,color:#F2F6FB;
    class A,B,C,E,F,I,J,K,M input;
    class D,G check;
    class H,L human;
