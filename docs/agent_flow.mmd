%% L10n Quality Agent: concise execution flow
flowchart TD
    INPUT["입력"] --> UI["Gradio UI"]
    UI --> WORKFLOW["Workflow"]
    WORKFLOW --> TRANSLATE["초기 번역"]
    TRANSLATE --> SAFETY["안전 검사"]
    SAFETY --> MQM["MQM 평가"]
    MQM --> INITIAL_RESULT{"오류?"}

    INITIAL_RESULT -->|"없음"| APPROVAL["사람 승인"]
    INITIAL_RESULT -->|"있음"| PLANNER["Qwen Planner"]
    PLANNER --> REVISION["전문 수정 체인"]
    REVISION --> RECHECK["후보 재검증"]
    RECHECK --> RESULT{"해결됐나?"}

    RESULT -->|"예"| APPROVAL
    RESULT -->|"다음 전략, 최대 2회"| PLANNER
    RESULT -->|"미해결"| ESCALATION{"OpenAI 사용?"}

    ESCALATION -->|"예"| OPENAI["OpenAI 수정"]
    OPENAI --> OPENAI_CHECK["동일 가드레일"]
    OPENAI_CHECK --> OPENAI_RESULT{"통과?"}
    OPENAI_RESULT -->|"예"| APPROVAL
    OPENAI_RESULT -->|"아니요"| REVIEW["사람 검토"]
    ESCALATION -->|"아니요"| REVIEW

    APPROVAL --> STORE["RunRecord + CSV"]
    REVIEW --> STORE
